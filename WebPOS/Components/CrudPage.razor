@typeparam TEntity

@if (CurrentView == ViewMode.List)
{
    <section class="crud-page">
        <div class="crud-header">
            <div>
                <div class="crud-kicker">Master Data</div>
                <h2 class="crud-title">@Title</h2>
                <p class="crud-subtitle">Manage your @Title.ToLowerInvariant() information and records.</p>
            </div>

            <SfButton CssClass="crud-primary-button"
                      IconCss="e-icons e-plus"
                      @onclick="ShowAdd">
                Add New
            </SfButton>
        </div>

        <div class="crud-card">
            <div class="crud-card-toolbar">
                <div class="crud-record-title">
                    <span class="crud-record-icon">
                        <i class="bi bi-list-ul"></i>
                    </span>
                    <div>
                        <strong>@Title List</strong>
                        <span>View, filter and manage records</span>
                    </div>
                </div>
            </div>

            <div class="crud-grid-wrap">
                <SfGrid TValue="TEntity"
                        DataSource="Items"
                        Width="100%"
                        AllowPaging="true"
                        AllowSorting="true"
                        AllowFiltering="true"
                        AllowResizing="true"
                        GridLines="GridLine.Horizontal">

                    <GridPageSettings PageSize="10"></GridPageSettings>

                    <GridColumns>
                        @foreach (var col in Columns)
                        {
                            <GridColumn Field="@col.Field"
                                        HeaderText="@col.Header"
                                        Width="@col.Width">
                            </GridColumn>
                        }

                        <GridColumn HeaderText="Actions"
                                    Width="130"
                                    TextAlign="TextAlign.Center">
                            <Template Context="context">
                                @{
                                    var entity = (TEntity)context;
                                }

                                <div class="grid-actions">
                                    <SfButton CssClass="grid-action edit"
                                              IconCss="e-icons e-edit"
                                              Title="Edit"
                                              @onclick="async () => await EditItem(entity)">
                                    </SfButton>

                                    <SfButton CssClass="grid-action delete"
                                              IconCss="e-icons e-delete"
                                              Title="Delete"
                                              @onclick="async () => await DeleteItem(entity)">
                                    </SfButton>
                                </div>
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
            </div>
        </div>
    </section>
}
else
{
    <section class="crud-page">
        <div class="crud-header form-page-header">
            <div>
                <button type="button" class="back-link" @onclick="BackToList">
                    <i class="bi bi-arrow-left"></i>
                    <span>Back to @Title</span>
                </button>

                <div class="crud-kicker">Master Data</div>
                <h2 class="crud-title">@((GetId(CurrentItem) == 0 ? "Add " : "Edit ") + Title.TrimEnd('s'))</h2>
                <p class="crud-subtitle">Enter the details below and save your changes.</p>
            </div>
        </div>

        <div class="crud-form-card">
            <div class="crud-form-header">
                <div class="crud-form-icon">
                    <i class="bi bi-person-plus"></i>
                </div>
                <div>
                    <h3>@((GetId(CurrentItem) == 0 ? "New " : "Edit ") + Title.TrimEnd('s') + " Details")</h3>
                    <p>Keep the information accurate for future transactions and reports.</p>
                </div>
            </div>

            <div class="crud-form-content">
                @FormTemplate(CurrentItem)
            </div>
        </div>
    </section>
}
