
@using DevExpress.Blazor
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject NavigationManager NavigationManager

<div class="sidebar">

    <!-- Navigation tree -->
    <div class="treeview-wrapper">
        <DxTreeView CssClass="pos-treeview"
                    SelectionMode="TreeViewSelectionMode.Single"
                    AnimationType="LayoutAnimationType.Slide">

            <Nodes>
                @foreach (var item in MenuData)
                {
                    @RenderNode(item)
                }
            </Nodes>

        </DxTreeView>
    </div>

    <!-- Footer user zone -->

</div>

@code {
    private string _currentUrl = string.Empty;

    protected override void OnInitialized()
    {
        _currentUrl = NavigationManager.Uri;
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = e.Location;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private RenderFragment RenderNode(MenuItem item) => builder =>
    {
        builder.OpenComponent<DxTreeViewNode>(0);
        builder.AddAttribute(1, "Text", item.Text);

        if (!string.IsNullOrWhiteSpace(item.Url))
        {
            builder.AddAttribute(2, "NavigateUrl", item.Url);
        }

        builder.AddAttribute(3, "IconCssClass", item.IconCss);

        if (!string.IsNullOrWhiteSpace(item.Url))
        {
            var currentPath = "/" + NavigationManager
                .ToBaseRelativePath(_currentUrl)
                .Split('?', '#')[0]
                .Trim('/');

            var itemPath = item.Url.Trim('/');

            var isSelected = string.Equals(
                currentPath,
                itemPath,
                StringComparison.OrdinalIgnoreCase);

            builder.AddAttribute(4, "Selected", isSelected);
        }

        if (item.Items is { Count: > 0 })
        {
            builder.AddAttribute(5, "Nodes", (RenderFragment)(childBuilder =>
            {
                var sequence = 0;

                foreach (var child in item.Items)
                {
                    childBuilder.AddContent(sequence++, RenderNode(child));
                }
            }));
        }

        builder.CloseComponent();
    };

    public class MenuItem
    {
        public string Text { get; set; } = string.Empty;

        public string Url { get; set; } = string.Empty;

        public string IconCss { get; set; } = string.Empty;

        public List<MenuItem>? Items { get; set; }
    }

    private readonly List<MenuItem> MenuData = new()
    {
        new()
        {
            Text = "Dashboard",
            Url = "/",
            IconCss = "fas fa-home"
        },
        new()
        {
            Text = "Masters",
            IconCss = "fas fa-database",
            Items = new()
            {
                new()
                {
                    Text = "Customers",
                    Url = "/customers",
                    IconCss = "fas fa-users"
                },
                new()
                {
                    Text = "Suppliers",
                    Url = "/suppliers",
                    IconCss = "fas fa-truck"
                },
                new()
                {
                    Text = "Products",
                    Url = "/products",
                    IconCss = "fas fa-box"
                },
                new()
                {
                    Text = "Sizes",
                    Url = "/sizespage",
                    IconCss = "fas fa-ruler"
                },
                new()
                {
                    Text = "Shops",
                    Url = "/shopnames",
                    IconCss = "fas fa-store"
                },
                new()
                {
                    Text = "Offers",
                    Url = "/offers",
                    IconCss = "fas fa-tags"
                }
            }
        },
        new()
        {
            Text = "Transactions",
            IconCss = "fas fa-exchange-alt",
            Items = new()
            {
                new()
                {
                    Text = "Purchases",
                    Url = "/purchases",
                    IconCss = "fas fa-shopping-cart"
                },
                new()
