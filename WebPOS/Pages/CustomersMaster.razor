@page "/customers"

@using Microsoft.AspNetCore.Components
@using Shared.Models
@using WebPOS.ColumnDefinations
@using WebPOS.Components
@using WebPOS.Services
@inject CustomerService CustomerService

<CrudPage TEntity="CustomerMaster"
          @ref="crudPage"
          Title="Customers"
          Items="customers"
          CurrentItem="customer"
          CurrentItemChanged="OnCurrentItemChanged"
          Columns="columns"
          GetId="c => c.CustomerId"
          OnDelete="DeleteCustomer">

    <FormTemplate Context="item">
        <EditForm Model="item"
                  OnValidSubmit="@(() => HandleValidSubmit(item))">

            <DataAnnotationsValidator />
            <ValidationSummary class="validation-summary" />

            <div class="form-section-title">
                <span>Contact information</span>
                <small>Fields marked with <b>*</b> are required.</small>
            </div>

            <div class="row g-3">

                <div class="col-lg-6">
                    <label class="professional-label" for="customer-name">
                        Customer Name <span>*</span>
                    </label>
                    <SfTextBox ID="customer-name"
                               CssClass="professional-input"
                               Placeholder="Enter customer name"
                               @bind-Value="item.Customer" />
                </div>

                <div class="col-lg-6">
                    <label class="professional-label" for="customer-mobile">
                        Mobile Number <span>*</span>
                    </label>
                    <SfTextBox ID="customer-mobile"
                               CssClass="professional-input"
                               Placeholder="Enter mobile number"
                               @bind-Value="item.MobileNo" />
                </div>

                <div class="col-lg-6">
                    <label class="professional-label" for="customer-telephone">
                        Telephone
                    </label>
                    <SfTextBox ID="customer-telephone"
                               CssClass="professional-input"
                               Placeholder="Enter telephone number"
                               @bind-Value="item.Telephone" />
                </div>

                <div class="col-lg-6">
                    <label class="professional-label" for="customer-email">
                        Email
                    </label>
                    <SfTextBox ID="customer-email"
                               CssClass="professional-input"
                               Placeholder="name@example.com"
                               @bind-Value="item.EmailId" />
                </div>

                <div class="col-12">
                    <label class="professional-label" for="customer-address">
                        Address
                    </label>
                    <SfTextBox ID="customer-address"
                               CssClass="professional-input"
                               Placeholder="Enter customer address"
                               Multiline="true"
                               @bind-Value="item.Caddress" />
                </div>

                <div class="col-lg-6">
                    <label class="professional-label" for="customer-city">
                        City
                    </label>
                    <SfTextBox ID="customer-city"
                               CssClass="professional-input"
                               Placeholder="Enter city"
                               @bind-Value="item.City" />
                </div>
            </div>

            <div class="form-actions">
                <button type="button"
                        class="btn-secondary-ui"
                        @onclick="() => crudPage?.Refresh()">
                    Cancel
                </button>

                <SfButton CssClass="crud-primary-button"
                          IconCss="e-icons e-check"
                          Type="Submit">
                    Save Customer
                </SfButton>
            </div>

        </EditForm>
    </FormTemplate>

</CrudPage>

@code {
    private CrudPage<CustomerMaster>? crudPage;

    private List<CustomerMaster> customers = new();
    private CustomerMaster customer = new();

    private readonly List<GridColumnDefinition> columns =
    [
        new() { Field = nameof(CustomerMaster.Customer), Header = "Customer", Width = "220" },
        new() { Field = nameof(CustomerMaster.City), Header = "City", Width = "180" },
        new() { Field = nameof(CustomerMaster.MobileNo), Header = "Mobile", Width = "180" }
    ];

    protected override async Task OnInitializedAsync()
    {
        customers = await CustomerService.GetCustomers();
    }

    private void OnCurrentItemChanged(CustomerMaster item)
    {
        customer = item;
    }

    private async Task HandleValidSubmit(CustomerMaster item)
    {
        if (item.CustomerId == 0)
            await CustomerService.AddCustomer(item);
        else
            await CustomerService.UpdateCustomer(item);

        customers = await CustomerService.GetCustomers();
        crudPage?.Refresh();
    }

    private async Task DeleteCustomer(int id)
    {
        await CustomerService.DeleteCustomer(id);
        customers = await CustomerService.GetCustomers();
    }
}
