@page "/offers"

@using Syncfusion.Blazor
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Cards

@using WebPOS.ViewModels

@inject OffersService OfferService
@inject DialogService DialogService
@inject ToastService ToastService

<EditForm Model="@Offer" OnValidSubmit="SaveOffer">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row">
     
        <div class="col-md-8">
            <SfCard CssClass="e-card shadow">
               

                <CardContent>
                    <div class="d-flex justify-content-end mb-2">
                        <SfButton CssClass="e-primary"
                                  IconCss="e-icons e-plus"
                                  OnClick="ShowAddForm">
                            Add Offer
                        </SfButton>
                    </div>

                    <SfGrid TValue="OfferViewModel"
                            DataSource="OfferList"
                            AllowPaging="true"
                            AllowSorting="true"
                            Width="100%">
                        <GridPageSettings PageSize="10" />

                        <GridColumns>
                            <GridColumn Field="ProductName" HeaderText="Product" Width="180" />
                            <GridColumn Field="Barcode" HeaderText="Barcode" Width="130" />
                            <GridColumn Field="MRP" HeaderText="MRP" Format="C2" Width="100" />
                            <GridColumn Field="OfferPrice" HeaderText="Offer Price" Format="C2" Width="120" />

                            <!-- ACTIVE -->
                            <GridColumn HeaderText="Active" Width="90" TextAlign="TextAlign.Center">
                                <Template Context="item">
                                    @{
                                        var offerRow = (OfferViewModel)item;
                                    }

                                    <SfSwitch TValue="bool"
                                              Checked="offerRow.IsActive"
                                              CheckedChanged="@((bool v) => OnStatusChange(offerRow, v))" />
                                </Template>
                            </GridColumn>


                            <!-- ACTIONS -->
                            <GridColumn HeaderText="Actions" Width="140" TextAlign="TextAlign.Center">
                                <Template Context="item">
                                    @{
                                        var offerRow = (OfferViewModel)item;
                                    }
                                    <SfButton CssClass="e-small e-info"
                                              IconCss="e-icons e-edit"
                                              OnClick="@(() => EditOffer(offerRow))" />
                                    <SfButton CssClass="e-small e-danger ms-2"
                                              IconCss="e-icons e-delete"
                                              OnClick="@(() => ConfirmDelete(offerRow.OfferId))" />
                                </Template>
                            </GridColumn>
                        </GridColumns>
                    </SfGrid>
                </CardContent>
            </SfCard>
        </div>

        <!-- RIGHT : OFFER FORM -->
        <div class="col-md-4">
            <SfCard CssClass="e-card shadow">
                <CardHeader>
                    <CardTitle>@(Offer.OfferId == 0 ? "Add Offer" : "Edit Offer")</CardTitle>
                </CardHeader>

                <CardContent>
                    <div class="mb-3">
                        <SfDropDownList TValue="int"
                                        TItem="ProductLookup"
                                        DataSource="Products"
                                        Placeholder="Select Product"
                                        @bind-Value="Offer.ProductId"
                                        Change="OnProductChanged"
                                        AllowFiltering="true"
                                        FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains">
                            <DropDownListFieldSettings Value="ProductId" Text="ProductName" />
                        </SfDropDownList>
                    </div>

                    <div class="mb-3">
                        <SfNumericTextBox TValue="decimal"
                                          @bind-Value="Offer.OfferPrice"
                                          Placeholder="Offer Price"
                                          Min="1"
                                          ShowSpinButton="false" />
                    </div>

                    <div class="mb-3">
                        <SfSwitch TValue="bool"
                                  @bind-Checked="Offer.IsActive"
                                  Label="Offer Active" />
                    </div>

                    <div class="text-center">
                        <SfButton CssClass="e-success" Type="Submit">Save</SfButton>
                        <SfButton CssClass="e-flat ms-2" OnClick="ResetForm">Clear</SfButton>
                    </div>
                </CardContent>
            </SfCard>
        </div>
    </div>
</EditForm>


@code {

    // __define-ocg__ state variables
    private List<OfferViewModel> OfferList = new();
    private List<ProductLookup> Products = new();

    private OfferViewModel Offer = new();
    private decimal SelectedMRP;

    protected override async Task OnInitializedAsync()
    {
        Products = await OfferService.GetProductLookups();
        OfferList = await OfferService.GetOffers();
    }

    private void ShowAddForm()
    {
        Offer = new OfferViewModel { IsActive = true };
        SelectedMRP = 0;
    }

    private void EditOffer(OfferViewModel row)
    {
        Offer = new OfferViewModel
        {
            OfferId = row.OfferId,
            ProductId = row.ProductId,
            OfferPrice = row.OfferPrice,
            IsActive = row.IsActive
        };

        SelectedMRP = row.SalePrice;
    }

    private async Task SaveOffer()
    {
        // Duplicate check
        if (OfferList.Any(o => o.ProductId == Offer.ProductId && o.OfferId != Offer.OfferId))
        {
            await ToastService.Warning("Offer already exists for this product");
            return;
        }

        // Price validation
        if (Offer.OfferPrice > SelectedMRP)
        {
            await ToastService.Error("Offer price cannot be greater than MRP");
            return;
        }

        await OfferService.SaveOffer(Offer);
        OfferList = await OfferService.GetOffers();

        ResetForm();
        await ToastService.Success("Offer saved successfully");
    }

    private void ResetForm()
    {
        Offer = new OfferViewModel { IsActive = true };
        SelectedMRP = 0;
        StateHasChanged();
    }

    private async Task ConfirmDelete(int offerId)
    {
        var confirmed = await DialogService.ConfirmAsync("Delete","Are you sure you want to delete this offer?");
        if (!confirmed) return;

        await OfferService.DeleteOffer(offerId);
        OfferList = await OfferService.GetOffers();
        await ToastService.Success("Offer deleted");
    }

    // private async Task OnStatusChange(OfferViewModel offer, bool status)
    // {
    //     offer.IsActive = status;
    //     try
    //     {
    //         await OfferService.UpdateStatus(offer.OfferId, status);
    //     }
    //     catch
    //     {
    //         offer.IsActive = !status;
    //         await ToastService.Error("Failed to update status");
    //     }
    // }
    private async Task OnStatusChange(OfferViewModel offer, bool isActive)
    {
        var previous = offer.IsActive;

        offer.IsActive = isActive; // __define-ocg__

        try
        {
            await OfferService.UpdateStatus(offer.OfferId, isActive);
        }
        catch
        {
            offer.IsActive = previous; // rollback
            throw;
        }
    }


    private void OnProductChanged(Syncfusion.Blazor.DropDowns.ChangeEventArgs<int, ProductLookup> args)
    {
        var product = Products.FirstOrDefault(p => p.ProductId == args.Value);
        SelectedMRP = product?.CostPrice ?? 0;
    }
}
