@page "/offers"

@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Buttons
@using WebPOS.ViewModels

@inject PurchaseService PurchaseService
@inject ToastService ToastService
@inject OffersService OfferService

<div class="container-fluid">

    <h4 class="text-primary mb-3">🎯 Batch Offer Update</h4>

    <!-- Barcode Scan -->
    <div class="row mb-3">
        <div class="col-md-4">
            <SfTextBox @ref="BarcodeTextBox"
                       Placeholder="Scan Barcode"
                       @bind-Value="ScannedBarcode"
                       ValueChange="@(async (ChangedEventArgs args) => await OnBarcodeScanned(args))">
            </SfTextBox>
        </div>
        <div class="col-md-8 text-end">
            <SfButton IconCss="e-icons e-edit" CssClass="e-success" OnClick="UpdateSalePrices">
                Update
           </SfButton>
           
        </div>
    </div>
    
    <!-- Grid -->
    <SfGrid @ref="Grid"
            TValue="OfferViewModel"
            DataSource="@ScannedList"
            AllowPaging="false"
            Width="100%">
        <GridEditSettings AllowEditing="true"
                          Mode="EditMode.Normal">
        </GridEditSettings>
        <GridColumns>
           <GridColumn Field="Id"  IsPrimaryKey="true" Visible="false"/> 


            <GridColumn Field="Barcode" HeaderText="Barcode" Width="130"
                       
                        AllowEditing="false" />
            <GridColumn Field="ShopName" HeaderText="Shop Name" Width="130"
                     
                        AllowEditing="false" />
            <GridColumn Field="ProductName" HeaderText="Product" Width="120"
                AllowEditing="false"/>

            <GridColumn Field="SizeName" HeaderText="Size" Width="120" 
                AllowEditing="false"/>

            <GridColumn Field="SalePrice"
                        HeaderText="Sale Price"
                        Format="C2"
                        TextAlign="TextAlign.Right"
                        Width="120"
                        AllowEditing="false" />

            <GridColumn Field="OfferPrice"
                        HeaderText="Offer Price"
                        Format="C2"
                        TextAlign="TextAlign.Right"
                        Width="120"
                        EditType="EditType.NumericEdit"
                        CustomAttributes="@(new Dictionary<string, object> { { "class", "offer-green-column" } })" />

        </GridColumns>
    </SfGrid>

</div>

@code
{

    private string ScannedBarcode = string.Empty;
    private SfTextBox BarcodeTextBox;
    private List<OfferViewModel> ScannedList = new();
    private SfGrid<OfferViewModel> Grid;

    private async Task OnBarcodeScanned(ChangedEventArgs args)
    {
        var value = args?.Value?.ToString();

        try
        {
            if (string.IsNullOrWhiteSpace(value))
                return;

            if (!int.TryParse(value, out var barcode) || barcode <= 0)
            {
                await ToastService.Error("Invalid barcode format");
                return;
            }


            var purchase = await PurchaseService.GetBarcodePurchase(barcode);

            if (purchase == null)
            {
                await ToastService.Error("Barcode not found");
                return;
            }

            

            // var offer = new OfferViewModel
            // {
            //     Id=purchase.Id,
            //     Barcode = purchase.Barcode,
            //     ProductName = purchase.ProductName,
            //     SizeName = purchase.SizeName,
            //     SalePrice = purchase.SalePrice,
            //     ShopName = purchase.ShopName
            // };

            // ScannedList.Add(offer);

            await Grid.Refresh();

            ScannedBarcode = string.Empty;
        }
        catch
        {
            await ToastService.Error("Something went wrong.");
        }
        finally
        {
            await BarcodeTextBox.FocusAsync();
        }
    }

    private async Task UpdateSalePrices()
    {
        if (!ScannedList.Any())
        {
            await ToastService.Warning("No records to update");
            return;
        }

        foreach (var item in ScannedList)
        {
            // var success = await OfferService.UpdateBarcodeAsync(
            //     item.Barcode,
            //     item.OfferPrice);

            // if (!success)
            // {
            //     await ToastService.Error($"Failed for barcode {item.Barcode}");
            //     return;
            // }
        }

        await ToastService.Success("Sale prices updated successfully");

        await Grid.Refresh();
    }
}
<style>
    /* Apply only to table body cells (td) */
    .e-grid .e-rowcell.offer-green-column {
        background-color: #d4edda !important;
    }

    
    /* Optional: Keep header untouched explicitly */
    .e-grid th.offer-green-column {
        background-color: #ff4789
    }
</style>