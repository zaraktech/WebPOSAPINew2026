@page "/products"


@using WebPOS.Components
@using global::Shared.Models

<CrudPage TEntity="ItemMaster"
          @ref="crudPage"
          Title="Products"
          Items="itemMasters"
          CurrentItem="itemMaster"
          CurrentItemChanged="OnCurrentItemChanged"
          Columns="columns"
          GetId="p => p.ItemId"
          OnDelete="DeleteProduct">

    <FormTemplate Context="item">

        <EditForm Model="item"
                  OnValidSubmit="@(() => HandleValidSubmit(item))">

            <DataAnnotationsValidator />

            <div class="mb-3">
                <label>Product Name</label>

                <InputText class="form-control"
                           @bind-Value="item.Item" width="40%" />
            </div>

            <div class="mb-3">
                <label>Discount</label>

                <InputNumber class="form-control"
                             @bind-Value="item.DisPercent" />
            </div>

            <div class="mb-3">
                <label>Reorder</label>

                <InputNumber class="form-control"
                             @bind-Value="item.ReOrder" />
            </div>

            <button type="submit"
                    class="btn btn-success">
                Save
            </button>

        </EditForm>

    </FormTemplate>

</CrudPage>