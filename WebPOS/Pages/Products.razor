@page "/products"

@using WebPOS.Components
@using global::Shared.Models

<CrudPage TEntity="ItemMaster"
          @ref="crudPage"
          Title="Products"
          Items="itemMasters"
          CurrentItem="itemMaster"
          CurrentItemChanged="OnCurrentItemChanged"
          Columns="columns"
          GetId="p => p.ItemId"
          OnDelete="DeleteProduct">

    <FormTemplate Context="item">

        <EditForm Model="item"
                  OnValidSubmit="@(() => HandleValidSubmit(item))">

            <DataAnnotationsValidator />

            <div class="row g-3">

                <!-- Product Name -->
                <div class="col-12">
                    <label class="form-label">Product Name</label>

                    <InputText class="form-control"
                               @bind-Value="item.Item"
                               placeholder="Enter product name" />
                </div>

                <!-- Discount -->
                <div class="col-md-6">
                    <label class="form-label">Discount</label>

                    <InputNumber class="form-control"
                                 @bind-Value="item.DisPercent" />
                </div>

                <!-- Reorder -->
                <div class="col-md-6">
                    <label class="form-label">Reorder Level</label>

                    <InputNumber class="form-control"
                                 @bind-Value="item.ReOrder" />
                </div>

                <!-- Save -->
                <div class="col-12 mt-4">
                    <button type="submit"
                            class="btn btn-success px-4">
                        Save
                    </button>
                </div>

            </div>

        </EditForm>

    </FormTemplate>

</CrudPage>