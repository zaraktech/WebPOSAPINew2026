@page "/purchases/new"
@page "/purchases/edit/{Id:int}"

@using Syncfusion.Blazor.Cards
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Spinner
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Layouts
@using WebPOS.Models

@inject PurchaseService PurchaseService
@inject SupplierService SupplierService
@inject ProductService ProductService
@inject SizeService SizeService
@inject ShopNamesService ShopNameService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ErrorLoggerService ErrorLogger
@inject ToastService ToastService
@inject DialogService DialogService



<div class="container p-4"
     style="max-width:1200px;background-color:#ff4081; border-radius:10px;">

    <SfCard CssClass="shadow" >

        <!-- HEADER -->
        <CardHeader>
            <h4 class="mb-0">
                @((purchase?.Id == 0 ? "Add New Purchase" : "Edit Purchase"))
            </h4>
        </CardHeader>

        <!-- CONTENT -->
        <CardContent>

            <EditForm Model="@purchase" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <!-- ROW 1 : BARCODE & DATE -->
                <div class="row mb-5">
                    <div class="col-md-6">
                        <label class="text-pink ms-1">Barcode</label>
                        <SfTextBox @bind-Value="purchase.BarcodeText"
                                   Placeholder="Barcode"
                                   FloatLabelType="FloatLabelType.Never"
                                   Readonly="true" />
                    </div>

                    <div class="col-md-6">
                        <label class="text-pink ms-1">Purchase Date</label>
                        <SfDatePicker TValue="DateTime?"
                                      @bind-Value="purchase.PurchaseDate"
                                      Placeholder="Purchase Date"
                                      FloatLabelType="FloatLabelType.Never" />
                    </div>
                </div>

                <!-- ROW 2 : SHOP, SUPPLIER, INVOICE -->
                <div class="row mb-5">
                    <div class="col-md-4">
                        <label class="text-pink">ShopName</label>
                        <SfComboBox TItem="ShopNames" TValue="int?"
                                    DataSource="shops"
                                    @bind-Value="purchase.ShopNamesId"
                                    Placeholder="Shop Name"
                                    FloatLabelType="FloatLabelType.Never"
                                    AllowFiltering="true"
                                    ShowClearButton="true"
                                    ValueChange="OnShopChanged">
                            <ComboBoxFieldSettings Text="ShopName"
                                                   Value="ShopNamesId" />
                        </SfComboBox>
                    </div>

                    <div class="col-md-4">
                        <label class="text-pink">Supplier</label>
                        <SfComboBox TItem="Supplier" TValue="int"
                                    DataSource="suppliers"
                                    @bind-Value="purchase.SupplierId"
                                    Placeholder="Supplier"
                                    FloatLabelType="FloatLabelType.Never"
                                    AllowFiltering="true"
                                    ShowClearButton="true">
                            <ComboBoxFieldSettings Text="SupplierName"
                                                   Value="SupplierId" />
                        </SfComboBox>
                    </div>

                    <div class="col-md-4">
                         <label class="text-pink"> Invoice No</label>
                        <SfTextBox @bind-Value="purchase.InvoiceNo"
                                   Placeholder="Invoice No"
                                   FloatLabelType="FloatLabelType.Never" />
                    </div>
                </div>

                <!-- ROW 3 : PRODUCT, SIZE, QTY -->
                <div class="row mb-5">
                    <div class="col-md-4">
                        <label class="text-pink"> Product</label>
                        <SfComboBox TItem="Product" TValue="int"
                                    DataSource="products"
                                    @bind-Value="purchase.ProductId"
                                    Placeholder="Product"
                                    FloatLabelType="FloatLabelType.Never"
                                    AllowFiltering="true"
                                    ShowClearButton="true">
                            <ComboBoxFieldSettings Text="ProductName"
                                                   Value="ProductId" />
                        </SfComboBox>
                    </div>

                    <div class="col-md-4">
                        <label class="text-pink"> Size</label>
                        <SfComboBox TItem="Sizes" TValue="int"
                                    DataSource="sizes"
                                    @bind-Value="purchase.SizeId"
                                    Placeholder="Size"
                                    FloatLabelType="FloatLabelType.Never"
                                    AllowFiltering="true"
                                    ShowClearButton="true">
                            <ComboBoxFieldSettings Text="SizeName"
                                                   Value="SizeId" />
                        </SfComboBox>
                    </div>

                    <div class="col-md-4">
                        <label class="text-pink"> Quantity</label>
                        <SfNumericTextBox TValue="int"
                                          @bind-Value="purchase.Qty"
                                          ValueChange="RecalculateTotal"
                                          Placeholder="Quantity"
                                          FloatLabelType="FloatLabelType.Never" />
                    </div>
                </div>

                <!-- ROW 4 : COST, SALE, DISCOUNT, TOTAL -->
                <div class="row mb-5">
                    <div class="col-md-3">
                        <label class="text-pink"> Cost Price</label>
                        <SfNumericTextBox TValue="decimal"
                                          @bind-Value="purchase.CostPrice"
                                          ValueChange="RecalculateTotal"
                                          Placeholder="Cost Price"
                                          FloatLabelType="FloatLabelType.Never"
                                          Format="C2" />
                    </div>

                    <div class="col-md-3">
                        <label class="text-pink"> Sale Price</label>
                        <SfNumericTextBox TValue="decimal"
                                          @bind-Value="purchase.SalePrice"
                                          ValueChange="RecalculateTotal"
                                          Placeholder="Sale Price"
                                          FloatLabelType="FloatLabelType.Never"
                                          Format="C2" />
                    </div>

                    <div class="col-md-3">
                        <label class="text-pink"> Discount </label>
                        <SfNumericTextBox TValue="decimal"
                                          @bind-Value="purchase.Discount"
                                          ValueChange="RecalculateTotal"
                                          Placeholder="Discount"
                                          FloatLabelType="FloatLabelType.Never"
                                          Format="C2" />
                    </div>

                    <div class="col-md-3">
                        <label class="text-pink"> Total Amount</label>
                        <SfNumericTextBox TValue="decimal"
                                          Value="purchase.TotalAmount"
                                          Readonly="true"
                                          Placeholder="Total Amount"
                                          FloatLabelType="FloatLabelType.Never"
                                          Format="C2" />
                    </div>
                </div>

                <!-- ACTION BUTTONS -->
                <div class="text-end mt-4">
                    <SfButton CssClass="e-primary me-2"
                              Type="Submit"
                              IsDisabled="isLoading">

                        @if (isLoading)
                        {
                            <SfSpinner Width="16px" CssClass="me-2" />
                            <span>Saving</span>
                        }
                        else
                        {
                            <i class="e-icons e-save me-1"></i>
                            <span>Save</span>
                        }
                    </SfButton>

                    <SfButton CssClass="e-outline"
                              OnClick="Cancel">
                        <i class="e-icons e-cancel me-1"></i>
                        Cancel
                    </SfButton>
                </div>

            </EditForm>

        </CardContent>
    </SfCard>
</div>

@code {
    [Parameter] public int? Id { get; set; }
    private PurchaseViewModel purchase = new();
    private bool isLoading = false;

    private List<Supplier> suppliers = new();
    private List<Product> products = new();
    private List<Sizes> sizes = new();
    private List<ShopNames> shops = new();

    // === Event Handlers ===

    private void OnQtyChanged(int qty)
    {
        purchase.Qty = qty;
        CalculateTotal();
    }

    private void OnCostPriceChanged(decimal costPrice)
    {
        purchase.CostPrice = costPrice;
        CalculateTotal();
    }

    private void OnDiscountChanged(decimal discount)
    {
        purchase.Discount = discount;
        CalculateTotal();
    }

    private void OnShopChanged(int? value)
    {
        purchase.ShopNamesId = value;
        Console.WriteLine($"Selected Shop ID: {value}");
    }

    // === Initialization ===
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            suppliers = await SupplierService.GetSuppliers();
            products = await ProductService.GetProducts();
            sizes = await SizeService.GetSizes();
            shops = await ShopNameService.GetShopNames();

            if (Id.HasValue)
            {
                purchase = await PurchaseService.GetPurchase(Id.Value);
            }
            else
            {
                purchase.PurchaseDate = DateTime.Today;
                purchase.BarcodeText = await GenerateBarcode();
            }
        }
        catch (Exception ex)
        {
            await ErrorLogger.LogAsync(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    // === Helper Methods ===
    private async Task<string> GenerateBarcode()
    {
        var purchases = await PurchaseService.GetPurchases();
        int lastBarcode = 2000;

        var lastPurchase = purchases.LastOrDefault();
        if (lastPurchase != null && int.TryParse(lastPurchase.Barcode.ToString(), out int parsed))
        {
            lastBarcode = parsed + 1;
        }

        purchase.Barcode = lastBarcode;
        return purchase.BarcodeText = lastBarcode.ToString();
    }

    private void CalculateTotal()
    {
        var total = purchase.Qty * purchase.CostPrice;
        if (purchase.Discount > 0)
        {
            total -= total * (purchase.Discount / 100);
        }
        purchase.TotalAmount = total;
    }

    private async Task HandleValidSubmit()
    {
        isLoading = true;
        try
        {
            if (purchase.Id == 0)
            {
                await GenerateBarcode();
                await PurchaseService.AddPurchase(purchase);
				await ToastService.Success("Purchase saved successfully.");
            }
            else
            {
                await PurchaseService.UpdatePurchase(purchase);
				await ToastService.Success("Purchase updated successfully.");
            }

            Navigation.NavigateTo("/purchases");
        }
        catch (Exception ex)
        {
            await ErrorLogger.LogAsync(ex.Message + " - " + ex.InnerException?.Message);
			await ToastService.Error("An error occurred while saving the purchase.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void Cancel() => Navigation.NavigateTo("/purchases");
}
<style>
   

    .text-pink{
        color: #ff4081;
       
    }
</style>