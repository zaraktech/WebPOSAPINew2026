@page "/shopnames"
@using WebPOS.ColumnDefinations
@using WebPOS.Components

@using global::Shared.Models
@inject StoreService storeService

<CrudPage TEntity="TblStore"
          @ref="crudPage"
          Items="shopNames"
          CurrentItem="shopName"
          CurrentItemChanged="OnCurrentItemChanged"
          Columns="columnDefinitions"
          GetId="s => s.StoreID"
          OnDelete="DeleteShopName">

    <FormTemplate Context="item">

        <EditForm Model="item"
                  OnValidSubmit="@(() => HandleValidSubmit(item))">

            <DataAnnotationsValidator />

            <div class="store-form-container">

                <SfCard CssClass="store-card">

                    <!-- Header -->
                    <div class="store-card-header">
                        <div>
                            <div class="store-title">
                                Store Information
                            </div>

                            <div class="store-subtitle">
                                Manage your store details and GST information
                            </div>
                        </div>
                    </div>

                    <CardContent>

                        <ValidationSummary class="validation-summary" />

                        <div class="row g-3">

                            <!-- Store Name -->
                            <div class="col-md-6">
                                <SfTextBox Placeholder="Enter store name"
                                           FloatLabelType="FloatLabelType.Auto"
                                           @bind-Value="item.Store">
                                </SfTextBox>
                            </div>

                            <!-- Mobile -->
                            <div class="col-md-6">
                                <SfTextBox Placeholder="Enter mobile number"
                                           FloatLabelType="FloatLabelType.Auto"
                                           @bind-Value="item.MobileNo">
                                </SfTextBox>
                            </div>

                            <!-- GST Number -->
                            <div class="col-md-6">
                                <SfTextBox Placeholder="Enter GST number"
                                           FloatLabelType="FloatLabelType.Auto"
                                           @bind-Value="item.Gstno">
                                </SfTextBox>
                            </div>

                            <!-- GST Percentage -->
                            <div class="col-md-6">
                                <SfNumericTextBox TValue="double?"
                                                  FloatLabelType="FloatLabelType.Auto"
                                                  Placeholder="GST percentage"
                                                  Min="0"
                                                  Max="100"
                                                  Decimals="2"
                                                  Format="N2"
                                                  ShowSpinButton="false"
                                                  @bind-Value="item.Gstpercent">
                                </SfNumericTextBox>
                            </div>

                            <!-- Address -->
                            <div class="col-12">
                                <SfTextBox Placeholder="Enter complete store address"
                                           Multiline="true"
                                           FloatLabelType="FloatLabelType.Auto"
                                           @bind-Value="item.Address">
                                </SfTextBox>
                            </div>

                        </div>

                    </CardContent>

                    <!-- Footer -->
                    <CardFooter>

                        <div class="store-form-actions">

                            <SfButton Type="ButtonType.Submit"
                                      CssClass="store-save-btn"
                                      IconCss="e-icons e-save">
                                Save
                            </SfButton>

                            <SfButton Type="ButtonType.Button"
                                      CssClass="store-clear-btn"
                                     >
                                Clear
                            </SfButton>

                        </div>

                    </CardFooter>

                </SfCard>

            </div>

        </EditForm>

    </FormTemplate>

</CrudPage>

@code {
    private List<TblStore> shopNames = new();

    private TblStore? shopName = new();

    private CrudPage<TblStore>? crudPage;
    protected override async Task OnInitializedAsync()
    {
        shopNames = await storeService.GetStores();
    }

    private List<GridColumnDefinition> columnDefinitions = new List<GridColumnDefinition>
    {

        new GridColumnDefinition { Field = "Store", Header = "Store Name", Width = "200" },
        new GridColumnDefinition { Field = "Address", Header = "Address", Width = "200" },
        new GridColumnDefinition { Field = "MobileNO", Header = "Mobile No", Width = "200" },
        new GridColumnDefinition { Field = "Gstno", Header = "GST No", Width = "200" },
        new GridColumnDefinition { Field = "Gstpercent", Header = "GST Percent", Width = "200" }


    };

    private Task OnCurrentItemChanged(TblStore shopNames)
    {
        shopName = shopNames;
        return Task.CompletedTask;
    }


    private async Task HandleValidSubmit(TblStore shopNames)

    {
        if (shopNames.StoreID == 0)
            await storeService.AddStore(shopNames);
        else
            await storeService.UpdateStore(shopNames);

        var response = await storeService.GetStores();


        crudPage?.Refresh();
    }


    private async Task DeleteShopName(int id)
    {
        await storeService.DeleteStore(id);

        var response = await storeService.GetStores();

    }
}