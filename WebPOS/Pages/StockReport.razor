@page "/stockreport"
@using WebPOS.ViewModels
@inject StockReportService StockReportService


<SfGrid DataSource="@StockList"
        AllowPaging="true"
        AllowSorting="true"
        AllowFiltering="true"
        Height="450">

    <GridPageSettings PageSize="20" />
    <GridSortSettings>
        <GridSortColumns>
            <GridSortColumn Field="Barcode" Direction="SortDirection.Ascending" />
        </GridSortColumns>
    </GridSortSettings>
    <GridColumns>
        <GridColumn Field="ShopName"
                    HeaderText="ShopName"
                    Width="150" />

        <GridColumn Field="Barcode"
                    HeaderText="Barcode"
                    Width="150" />

        <GridColumn Field="ProductName"
                    HeaderText="Product"
                    Width="200" />

        <GridColumn Field="Size"
                    HeaderText="Size"
                    Width="90"
                    TextAlign="TextAlign.Center" />

        <GridColumn Field="PurchaseQty"
                    HeaderText="Purchase"
                    Width="110"
                  
                    TextAlign="TextAlign.Right" />

        <GridColumn Field="SalesQty"
                    HeaderText="Sales"
                    Width="100"
                  
                    TextAlign="TextAlign.Right" />

        <GridColumn Field="BalanceQty"
                    HeaderText="Balance"
                    Width="110"
      
                    TextAlign="TextAlign.Right" />

        <GridColumn Field="SalePrice"
                    HeaderText="Sale Price"
                    Width="120"
                    Format="C2"
                    TextAlign="TextAlign.Right" />

        <GridColumn Field="StockValue"
                    HeaderText="Value"
                    Width="140"
                    Format="C2"
                    TextAlign="TextAlign.Right" />
    </GridColumns>

    <GridAggregates>
        <GridAggregate>
            <GridAggregateColumns>
                <GridAggregateColumn Field="PurchaseQty" Type="AggregateType.Sum" />
                <GridAggregateColumn Field="SalesQty" Type="AggregateType.Sum" />
                <GridAggregateColumn Field="BalanceQty" Type="AggregateType.Sum" />
                <GridAggregateColumn Field="StockValue" Type="AggregateType.Sum" Format="C2" />
            </GridAggregateColumns>
        </GridAggregate>
    </GridAggregates>

</SfGrid>



@code   {
    private List<StockReportViewModel> StockList = new();
    private bool isLoading;

    protected override async Task OnInitializedAsync()
    {
        await LoadStock();
    }

    private async Task LoadStock()
    {
        isLoading = true;


        try
        {
            StockList = await StockReportService.GetStockReportAsync();
        }
        catch (Exception ex)
        {
            
			Console.WriteLine($"Error loading stock report: {ex.Message}");
        }
       

        isLoading = false;
    }

}