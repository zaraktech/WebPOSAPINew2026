            var to = EndValue ?? DateTime.MaxValue;

            // query = query.Where(p =>
            //     p.Purid == SelectedShopId &&
            //     p.PurDate >= from &&
            //     p.PurDate <= to);
        }

        FilteredPurchases = query.ToList();
    }

