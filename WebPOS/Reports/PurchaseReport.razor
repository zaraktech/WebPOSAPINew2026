@page "/purchase-report"

@using Syncfusion.Blazor.Grids
@using WebPOS.ViewModels
@using Shared.Models

@inject PurchaseService PurchaseService
@inject StoreService ShopNamesService



<!-- 🔵 Bootstrap Card -->
<div class="card shadow-sm mb-3">
    <div class="card-body">
        <div class="container-fluid">
            <div class="row align-items-end">

                <!-- Shop selection -->
                <div class="col-md-4 mb-3">
                    <label class="form-label">Select Shop</label>
                    <select class="form-select"
                            @bind="SelectedShopId">
                        <option value="">-- Select Shop --</option>
                        @foreach (var shop in Shops)
                        {
                            @* <option value="@shop.ShopNamesId">@shop.ShopName</option> *@
                        }
                    </select>
                </div>

                <!-- Date Range -->
                <div class="col-md-4 mb-3">
                    <label class="form-label">Select Date Range</label>

                    <div class="input-group">
                        <input type="date" class="form-control"
                               @bind="StartValue" />

                        <span class="input-group-text">to</span>

                        <input type="date" class="form-control"
                               @bind="EndValue" />
                    </div>
                </div>

                <!-- Filter button -->
                <div class="col-md-4 mb-3">
                    <button class="btn btn-primary w-100"
                            style="padding: 10px 0;"
                            @onclick="FilterPurchases">
                        Filter
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>

@if (FilteredPurchases?.Any() == true)
{
    <SfGrid DataSource="@FilteredPurchases" AllowPaging="true" AllowSorting="true" AllowFiltering="true">
        <GridColumns>
            <GridColumn Field="SupplierName" HeaderText="Supplier" Width="150"></GridColumn>
            <GridColumn Field="PurchaseDate" HeaderText="Purchase Date" Format="dd/MM/yyyy" Width="120"></GridColumn>
            <GridColumn Field="ProductName" HeaderText="Product" Width="150"></GridColumn>
            <GridColumn Field="SizeName" HeaderText="Size" Width="80"></GridColumn>
            <GridColumn Field="Qty" HeaderText="Qty" TextAlign="TextAlign.Right" Width="80"></GridColumn>
            <GridColumn Field="CostPrice" HeaderText="Cost Price" Format="C2" TextAlign="TextAlign.Right" Width="100"></GridColumn>
            <GridColumn Field="Amount" HeaderText="Amount" Format="C2" TextAlign="TextAlign.Right" Width="120"></GridColumn>
        </GridColumns>
    </SfGrid>
}
else if (IsLoaded)
{
    <p>No purchases found for the selected criteria.</p>
}
else
{
    <p>Loading purchases...</p>
}

